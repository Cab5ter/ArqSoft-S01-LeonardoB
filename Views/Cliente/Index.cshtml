@model List<Catalogo.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<h1>Clientes Registrados</h1>

<ul>
    @foreach (var cliente in Model)
    {
        <li>
            <strong>@cliente.Nombre</strong> — @cliente.Email | @cliente.Telefono
            <br />
            <a asp-action="Detalle" asp-route-id="@cliente.Id">Ver detalle</a>
        </li>
        <br />
    }
</ul>

<hr />

<a asp-action="Agregar" class="btn btn-primary">+ Agregar Cliente</a>
