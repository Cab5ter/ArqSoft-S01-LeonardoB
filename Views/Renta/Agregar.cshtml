@model Catalogo.Models.Renta

@{
    ViewData["Title"] = "Nueva Renta";
    var videojuegos = ViewBag.Videojuegos as List<Catalogo.Models.Item>;
    var clientes = ViewBag.Clientes as List<Catalogo.Models.Cliente>;
}

<h1>Registrar nueva renta</h1>

<form asp-action="Agregar" method="post">
    <div class="form-group" style="margin-bottom: 15px;">
        <label>Videojuego</label>
        <select asp-for="VideojuegoId" class="form-control">
            @foreach (var v in videojuegos ?? new List<Catalogo.Models.Item>())
            {
                <option value="@v.Id">@v.Titulo (@v.Consola)</option>
            }
        </select>
    </div>

    <div class="form-group" style="margin-bottom: 15px;">
        <label>Cliente</label>
        <select asp-for="ClienteId" class="form-control">
            @foreach (var c in clientes ?? new List<Catalogo.Models.Cliente>())
            {
                <option value="@c.Id">@c.Nombre</option>
            }
        </select>
    </div>

    <div class="form-group" style="margin-bottom: 15px;">
        <label>Fecha de Renta</label>
        <input asp-for="FechaRenta" type="date" class="form-control" />
    </div>

    <div class="form-group" style="margin-bottom: 15px;">
        <label>Fecha de Devolución</label>
        <input asp-for="FechaDevolucion" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Registrar Renta</button>
</form>

<hr />
<a asp-action="Index" class="btn btn-link">← Cancelar y volver</a>
